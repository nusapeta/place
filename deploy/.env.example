# Salin ke deploy/.env lalu sesuaikan. Jangan commit file .env.
#
# Tanpa override (satu host, index di ../data):
COMPOSE_FILE=docker-compose.yml

# Dengan tunnel container di jaringan eksternal:
# COMPOSE_FILE=docker-compose.yml:examples/homelab/docker-compose.override.yml
# TUNNEL_NETWORK=1panel-network

# Image publik; ganti dengan build lokal (nusapeta-place:0.1) saat menguji.
NUSA_PLACE_IMAGE=ghcr.io/nusapeta/place:0.1.0

# Port host, hanya loopback. Ganti kalau 8090 sudah dipakai.
NUSA_PLACE_PORT=8090
