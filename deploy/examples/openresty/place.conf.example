# Contoh vhost reverse proxy untuk Nusapeta Place. Salin ke site config
# nginx/openresty Anda, ganti place.example.com dan path sertifikat, lalu
# `nginx -t && nginx -s reload`. Place sendiri tidak punya TLS atau rate limit.
limit_req_zone $binary_remote_addr zone=nusapeta-place:10m rate=20r/s;

# Port 80 melayani redirect. Kalau ada proxy lain di depan (mis. Cloudflare
# Flexible), redirect tanpa syarat bisa membuat loop; karena itu header
# X-Forwarded-Proto diperiksa.
server {
    listen 80;
    server_name place.example.com;

    access_log /var/log/nginx/place-access.log;
    error_log /var/log/nginx/place-error.log;

    client_max_body_size 1m;

    if ($http_x_forwarded_proto = "") {
        return 301 https://$host$request_uri;
    }

    location = /metrics {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        limit_req zone=nusapeta-place burst=40 nodelay;
        limit_req_status 429;
        proxy_read_timeout 15s;
        proxy_connect_timeout 3s;
    }
}

server {
    listen 443 ssl http2;
    server_name place.example.com;

    ssl_certificate /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols TLSv1.3 TLSv1.2;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    access_log /var/log/nginx/place-access.log;
    error_log /var/log/nginx/place-error.log;

    client_max_body_size 1m;

    # Jangan pernah menerbitkan /metrics: isinya ukuran, umur, dan jumlah fitur.
    location = /metrics {
        return 404;
    }

    location = /healthz {
        access_log off;
        proxy_pass http://127.0.0.1:8090;
    }

    location / {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        limit_req zone=nusapeta-place burst=40 nodelay;
        limit_req_status 429;
        proxy_read_timeout 15s;
        proxy_connect_timeout 3s;
    }
}
